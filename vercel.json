{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install",
  "buildCommand": "BASE_PATH=/ pnpm --filter @workspace/gtm-studio run build",
  "outputDirectory": "artifacts/gtm-studio/dist/public",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
